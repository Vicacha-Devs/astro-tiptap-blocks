{
  "name": "@vicacha-devs/astro-tiptap-blocks",
  "version": "1.2.0",
  "description": "Zero-JS Astro block components and themeable renderer for Tiptap & Strapi Tiptap Editor (JSON, HTML & Markdown)",
  "keywords": [
    "astro",
    "tiptap",
    "prosemirror",
    "strapi",
    "blocks",
    "rich-text",
    "astro-component",
    "withastro",
    "tailwindcss",
    "storybook-astro"
  ],
  "type": "module",
  "main": "./src/components/TiptapBlocks/TiptapBlocks.astro",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./astro": {
      "types": "./src/index.d.ts",
      "default": "./src/components/TiptapBlocks/TiptapBlocks.astro"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./components/*": "./src/components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.stories.ts",
    "!src/**/*.test.ts",
    "!src/vitest.setup.ts",
    "!src/utils/test.helpers.ts"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build-storybook": "storybook build",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:stories": "vitest run --config vitest.storybook.config.ts"
  },
  "devDependencies": {
    "@storybook-astro/framework": "1.8.0",
    "@storybook-astro/renderer": "^1.8.0",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-designs": "12.0.0",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/builder-vite": "10.4.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "^22.0.0",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "astro": "^6.0.0 || ^7.0.0",
    "happy-dom": "20.10.6",
    "playwright": "^1.64.1",
    "remark-gfm": "^4.0.1",
    "storybook": "10.4.6",
    "storybook-addon-rtl": "3.0.2",
    "storybook-addon-tag-badges": "3.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vicacha-Devs/astro-tiptap-blocks.git"
  },
  "bugs": {
    "url": "https://github.com/Vicacha-Devs/astro-tiptap-blocks/issues"
  },
  "homepage": "https://github.com/Vicacha-Devs/astro-tiptap-blocks#readme"
}
