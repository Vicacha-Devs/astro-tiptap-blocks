{
  "name": "@vicacha-devs/astro-tiptap-blocks",
  "version": "1.2.0",
  "description": "Zero-JS Astro block components and themeable renderer for Tiptap & ProseMirror rich text (JSON, HTML & Markdown)",
  "keywords": [
    "astro",
    "astro-component",
    "blocks",
    "prosemirror",
    "rich-text",
    "storybook-astro",
    "tailwindcss",
    "tiptap",
    "withastro"
  ],
  "homepage": "https://github.com/Vicacha-Devs/astro-tiptap-blocks#readme",
  "bugs": {
    "url": "https://github.com/Vicacha-Devs/astro-tiptap-blocks/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vicacha-Devs/astro-tiptap-blocks.git"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.mdx",
    "!src/**/README.md",
    "!src/**/*.stories.ts",
    "!src/**/*.test.ts",
    "!src/components/blocks/TiptapLibPreview/**",
    "!src/env.d.ts",
    "!src/vitest.setup.ts",
    "!src/utils/**"
  ],
  "type": "module",
  "main": "./src/components/TiptapBlocks/TiptapBlocks.astro",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "astro": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./astro": {
      "types": "./src/index.d.ts",
      "astro": "./src/components/TiptapBlocks/TiptapBlocks.astro",
      "default": "./src/components/TiptapBlocks/TiptapBlocks.astro"
    },
    "./components": {
      "types": "./src/components/index.d.ts",
      "astro": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./components/*": "./src/components/*",
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "build:storybook": "storybook build",
    "check": "tsc --noEmit",
    "dev": "storybook dev -p 6006",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && eslint .",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "lint:oxc": "oxlint",
    "prepare": "husky",
    "publint": "publint",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test:coverage && pnpm build && pnpm publint"
  },
  "dependencies": {
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@storybook-astro/framework": "1.14.0",
    "@storybook-astro/renderer": "1.14.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-designs": "12.0.0",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/builder-vite": "10.6.5",
    "@stylistic/eslint-plugin": "6.0.0-beta.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@vitest/ui": "5.0.5",
    "astro": "^7.4.4",
    "astro-eslint-parser": "3.2.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "^1.64.1",
    "publint": "0.3.25",
    "remark-gfm": "^4.0.1",
    "semantic-release": "25.0.9",
    "storybook": "10.6.5",
    "storybook-addon-rtl": "3.0.2",
    "storybook-addon-tag-badges": "3.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20.16.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.3"
}
