---
import type { TiptapBlockNode, TiptapBlockTheme } from "../../../types";
import TiptapBlockCode from "../TiptapBlockCode.astro";
import TiptapBlockHeading from "../TiptapBlockHeading.astro";
import TiptapBlockHr from "../TiptapBlockHr.astro";
import TiptapBlockImage from "../TiptapBlockImage.astro";
import TiptapBlockList from "../TiptapBlockList.astro";
import TiptapBlockParagraph from "../TiptapBlockParagraph.astro";
import TiptapBlockTable from "../TiptapBlockTable.astro";
import TiptapInlineNodes from "./TiptapInlineNodes.astro";

interface Props {
  blocks?: TiptapBlockNode[];
  theme: TiptapBlockTheme;
}

const { blocks = [], theme } = Astro.props;
---

{
  blocks.map((block) => {
    switch (block.type) {
      case "heading":
        return <TiptapBlockHeading {...block} theme={theme} />;
      case "paragraph":
      case "leadParagraph":
        return <TiptapBlockParagraph {...block} theme={theme} />;
      case "bulletList":
      case "orderedList":
      case "taskList":
        return <TiptapBlockList {...block} theme={theme} />;
      case "codeBlock":
        return <TiptapBlockCode {...block} theme={theme} />;
      case "image":
        return <TiptapBlockImage {...block} theme={theme} />;
      case "table":
        return <TiptapBlockTable {...block} theme={theme} />;
      case "horizontalRule":
        return <TiptapBlockHr {...block} theme={theme} />;
      default:
        if ("content" in block && Array.isArray(block.content)) {
          return (
            <p>
              <TiptapInlineNodes nodes={block.content as any} theme={theme.paragraph} />
            </p>
          );
        }
        return null;
    }
  })
}
