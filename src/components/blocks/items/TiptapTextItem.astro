---
import { buildSafeInlineStyle, sanitizeCssColor } from "../../../lib/sanitize";
import { getPropertyClass } from "../../../lib/theme";
import type { TiptapBlockThemeParagraph } from "../../../types/theme";
import type { TiptapMark, TiptapTextNode } from "../../../types/tiptap";

interface Props extends TiptapTextNode {
  theme: TiptapBlockThemeParagraph;
}

const { text, marks = [], theme } = Astro.props;

const hasMark = (markType: TiptapMark["type"]): boolean =>
  marks.some((mark) => mark.type === markType);

const isBold = hasMark("bold");
const isItalic = hasMark("italic");
const isUnderline = hasMark("underline");
const isStrike = hasMark("strike");
const isCode = hasMark("code");
const isSubscript = hasMark("subscript");
const isSuperscript = hasMark("superscript");
const isHighlight = hasMark("highlight");
const isAbbr = hasMark("abbr");
const isLanguage = hasMark("language");

const highlightMark = marks.find(
  (m): m is Extract<TiptapMark, { type: "highlight" }> => m.type === "highlight"
);
const textStyleMark = marks.find(
  (m): m is Extract<TiptapMark, { type: "textStyle" }> => m.type === "textStyle"
);
const abbrMark = marks.find(
  (m): m is Extract<TiptapMark, { type: "abbr" }> => m.type === "abbr"
);
const languageMark = marks.find(
  (m): m is Extract<TiptapMark, { type: "language" }> => m.type === "language"
);

const highlightColor = sanitizeCssColor(highlightMark?.attrs?.color);
const textStyleStr = buildSafeInlineStyle(textStyleMark?.attrs);
const combinedStyle = [
  highlightColor ? `background-color: ${highlightColor}` : "",
  textStyleStr || "",
]
  .filter(Boolean)
  .join("; ") || undefined;

const activeClasses = [
  isBold ? getPropertyClass(theme.bold) : "",
  isItalic ? getPropertyClass(theme.italic) : "",
  isUnderline ? getPropertyClass(theme.underline) : "",
  isStrike ? getPropertyClass(theme.strikethrough) : "",
  isCode ? getPropertyClass(theme.code) : "",
  isHighlight ? getPropertyClass(theme.highlight) : "",
  isSubscript ? getPropertyClass(theme.subscript) : "",
  isSuperscript ? getPropertyClass(theme.superscript) : "",
  isAbbr ? getPropertyClass(theme.abbr) : "",
  isLanguage ? getPropertyClass(theme.language) : "",
]
  .filter(Boolean)
  .join(" ")
  .trim();

const langAttr = languageMark?.attrs?.lang || undefined;
const dirAttr = languageMark?.attrs?.dir || undefined;
const abbrTitle = abbrMark?.attrs?.title || undefined;
---

{
  isCode ? (
    <code class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</code>
  ) : isAbbr ? (
    <abbr title={abbrTitle} class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>
      {isBold ? <strong>{text}</strong> : isItalic ? <em>{text}</em> : text}
    </abbr>
  ) : isHighlight ? (
    <mark
      data-color={highlightColor || undefined}
      class:list={[activeClasses || undefined]}
      style={combinedStyle}
      lang={langAttr}
      dir={dirAttr}
    >
      {isBold ? <strong>{text}</strong> : isItalic ? <em>{text}</em> : text}
    </mark>
  ) : isSubscript ? (
    <sub class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</sub>
  ) : isSuperscript ? (
    <sup class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</sup>
  ) : isBold && isItalic ? (
    <strong class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>
      <em>{text}</em>
    </strong>
  ) : isBold ? (
    <strong class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</strong>
  ) : isItalic ? (
    <em class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</em>
  ) : isUnderline ? (
    <u class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</u>
  ) : isStrike ? (
    <s class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</s>
  ) : activeClasses || combinedStyle || langAttr || dirAttr ? (
    <span class:list={[activeClasses || undefined]} style={combinedStyle} lang={langAttr} dir={dirAttr}>{text}</span>
  ) : (
    text
  )
}
