---
import { resolveInternalLinkHref } from "../../../../lib/relations";
import { formatLatexPreview } from "../../../../lib/sanitize";
import { getPropertyClass, TiptapBlockThemeDefault } from "../../../../lib/theme";
import type { TiptapBlockThemeParagraph } from "../../../../types/theme";
import type {
  TiptapInlineNode,
  TiptapInternalLinkResolver,
  TiptapLinkMark,
} from "../../../../types/tiptap";
import TiptapLinkItem from "../TiptapLinkItem/TiptapLinkItem.astro";
import TiptapTextItem from "../TiptapTextItem/TiptapTextItem.astro";

/**
 * @component TiptapInlineNodes
 * @title Tiptap Inline Nodes Dispatcher
 * @description Dispatches an array of inline AST nodes (`text`, `hardBreak`, `linker`, inline `mathematics`)
 * to their corresponding inline Astro renderers.
 *
 * @preview
 *
 * <TiptapInlineNodes
 *   nodes={[
 *     { type: "text", text: "Bold text", marks: [{ type: "bold" }] },
 *     { type: "hardBreak" },
 *     { type: "mathematics", attrs: { latex: "E = mc^2", displayMode: "inline" } },
 *   ]}
 * />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import TiptapInlineNodes from "@components/blocks/items/TiptapInlineNodes/TiptapInlineNodes.astro";
 * ---
 *
 * <TiptapInlineNodes nodes={paragraphNode.content} />
 * ```
 */
export interface Props {
  /**
   * Array of inline AST nodes to render.
   * @default []
   */
  nodes?: TiptapInlineNode[];
  /**
   * Paragraph/inline theme configuration object.
   * @default TiptapBlockThemeDefault.paragraph
   */
  theme?: TiptapBlockThemeParagraph;
  /**
   * Optional callback to resolve internal links (`tiptap://collectionName/documentId` and `linker` nodes).
   */
  resolveInternalLink?: TiptapInternalLinkResolver;
}

const { nodes = [], theme = TiptapBlockThemeDefault.paragraph, resolveInternalLink } = Astro.props;
const linkerClass = getPropertyClass(theme.linker || theme.link);
const mathInlineClass = getPropertyClass(theme.mathInline);
---

{nodes.map((node) => {
  if (node.type === "hardBreak") {
    return <br />;
  }
  if (node.type === "linker") {
    const safeHref = resolveInternalLinkHref(node.attrs || {}, resolveInternalLink);
    const label = node.attrs?.label || node.attrs?.documentId || "Internal Link";
    return <a
      href={safeHref}
      data-type="linker"
      data-collection={node.attrs?.collectionName || undefined}
      data-document-id={node.attrs?.documentId || undefined}
      data-label={node.attrs?.label || undefined}
      class:list={[linkerClass || undefined]}
    >
      {label}
    </a>;
  }
  if (node.type === "mathematics") {
    const latex = node.attrs?.latex || "";
    return <span
      data-type="mathematics"
      data-latex={latex}
      data-display-mode="inline"
      role="math"
      aria-label={latex}
      class:list={[mathInlineClass || undefined]}
    >
      {formatLatexPreview(latex)}
    </span>;
  }
  if (node.type === "text") {
    const linkMark = node.marks?.find((m): m is TiptapLinkMark => m.type === "link");
    if (linkMark) {
      return <TiptapLinkItem {...node} {linkMark} {theme} {resolveInternalLink} />;
    }
    return <TiptapTextItem {...node} {theme} />;
  }
  return null;
})}
