---
import { renderPropertyClasses, TiptapBlockThemeDefault } from "../../../../lib/theme";
import type {
  TiptapBlockNode,
  TiptapBlockTheme,
  TiptapBlockUserComponents,
  TiptapCustomBlockNode,
} from "../../../../types";
import TiptapBlockCode from "../../TiptapBlockCode/TiptapBlockCode.astro";
import TiptapBlockCustom from "../../TiptapBlockCustom/TiptapBlockCustom.astro";
import TiptapBlockHeading from "../../TiptapBlockHeading/TiptapBlockHeading.astro";
import TiptapBlockHr from "../../TiptapBlockHr/TiptapBlockHr.astro";
import TiptapBlockImage from "../../TiptapBlockImage/TiptapBlockImage.astro";
import TiptapBlockList from "../../TiptapBlockList/TiptapBlockList.astro";
import TiptapBlockMath from "../../TiptapBlockMath/TiptapBlockMath.astro";
import TiptapBlockMedia from "../../TiptapBlockMedia/TiptapBlockMedia.astro";
import TiptapBlockParagraph from "../../TiptapBlockParagraph/TiptapBlockParagraph.astro";
import TiptapBlockTable from "../../TiptapBlockTable/TiptapBlockTable.astro";

/**
 * @component TiptapNestedBlocks
 * @title Tiptap Nested Blocks Renderer
 * @description Renders nested `TiptapBlockNode[]` children inside container blocks
 * (`blockquote`, `informationPane`, `conversationHistory`, `details`, `layoutColumn`),
 * including headings, paragraphs, lists, code blocks, images, media, math, tables, and custom blocks.
 *
 * @preview
 *
 * <TiptapNestedBlocks
 *   blocks={[
 *     { type: "paragraph", content: [{ type: "text", text: "Nested paragraph block." }] },
 *   ]}
 * />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import TiptapNestedBlocks from "@components/blocks/items/TiptapNestedBlocks/TiptapNestedBlocks.astro";
 * ---
 *
 * <TiptapNestedBlocks blocks={containerNode.content} />
 * ```
 */
export interface Props {
  /**
   * Array of nested block AST nodes to render.
   * @default []
   */
  blocks?: Array<TiptapBlockNode | TiptapCustomBlockNode>;
  /**
   * Resolved block theme object.
   * @default TiptapBlockThemeDefault
   */
  theme?: TiptapBlockTheme;
  /**
   * Optional custom Astro block component overrides.
   * @default {}
   */
  customBlocks?: TiptapBlockUserComponents;
}

const { blocks = [], theme = TiptapBlockThemeDefault, customBlocks = {} } = Astro.props;
const quoteClass = renderPropertyClasses(theme.quote);
---

{blocks.map((block) => {
  const customComponent = customBlocks[block.type];
  if (customComponent) {
    return <TiptapBlockCustom component={customComponent} {...block} {theme} />;
  }
  const typedBlock = block as TiptapBlockNode;
  switch (typedBlock.type) {
    case "heading":
      return <TiptapBlockHeading {...typedBlock} {theme} />;
    case "paragraph":
    case "leadParagraph":
      return <TiptapBlockParagraph {...typedBlock} {theme} />;
    case "bulletList":
    case "orderedList":
    case "taskList":
      return <TiptapBlockList {...typedBlock} {theme} />;
    case "codeBlock":
      return <TiptapBlockCode {...typedBlock} {theme} />;
    case "image":
      return <TiptapBlockImage {...typedBlock} {theme} />;
    case "video":
    case "audio":
    case "attachment":
    case "iframe":
      return <TiptapBlockMedia {...typedBlock} {theme} />;
    case "mathematics":
      return <TiptapBlockMath {...typedBlock} {theme} />;
    case "table":
      return <TiptapBlockTable {...typedBlock} {theme} />;
    case "horizontalRule":
      return <TiptapBlockHr {...typedBlock} {theme} />;
    case "blockquote":
      return <blockquote class:list={[quoteClass || undefined]}>
        <Astro.self blocks={typedBlock.content} {theme} {customBlocks} />
      </blockquote>;
    default:
      return null;
  }
})}
