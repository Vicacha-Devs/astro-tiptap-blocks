---
import { sanitizeCssColor } from "../../../lib/sanitize";
import {
  getPropertyClass,
  renderPropertyClasses,
  TiptapBlockThemeDefault,
} from "../../../lib/theme";
import type {
  TiptapBlockTheme,
  TiptapInternalLinkResolver,
  TiptapTableCellNode,
  TiptapTableNode,
  TiptapTableRowNode,
} from "../../../types";
import TiptapInlineNodes from "../items/TiptapInlineNodes/TiptapInlineNodes.astro";
import TiptapBlockCode from "../TiptapBlockCode/TiptapBlockCode.astro";
import TiptapBlockHeading from "../TiptapBlockHeading/TiptapBlockHeading.astro";
import TiptapBlockHr from "../TiptapBlockHr/TiptapBlockHr.astro";
import TiptapBlockImage from "../TiptapBlockImage/TiptapBlockImage.astro";
import TiptapBlockList from "../TiptapBlockList/TiptapBlockList.astro";
import TiptapBlockMath from "../TiptapBlockMath/TiptapBlockMath.astro";

/**
 * @component TiptapBlockTable
 * @title Tiptap Block Table
 * @description Renders a semantic `<table>` with `<thead>` and `<tbody>`, supporting `colspan`, `rowspan`,
 * column widths (`colwidth`), sanitized cell `backgroundColor`, and nested paragraphs/lists inside cells.
 *
 * @preview
 *
 * <TiptapBlockTable
 *   content={[
 *     {
 *       type: "tableRow",
 *       content: [
 *         { type: "tableHeader", content: [{ type: "paragraph", content: [{ type: "text", text: "Column" }] }] },
 *       ],
 *     },
 *   ]}
 * />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import TiptapBlockTable from "@components/blocks/TiptapBlockTable/TiptapBlockTable.astro";
 * ---
 *
 * <TiptapBlockTable content={tableNode.content} />
 * ```
 */
export interface Props {
  /**
   * Discriminator node type.
   * @default "table"
   */
  type?: TiptapTableNode["type"];
  /**
   * Array of `tableRow` nodes containing `tableHeader` and `tableCell` children.
   * @default []
   */
  content?: Array<TiptapTableRowNode>;
  /**
   * Resolved block theme object.
   * @default TiptapBlockThemeDefault
   */
  theme?: TiptapBlockTheme;
  /**
   * Optional callback to resolve internal links (`tiptap://collectionName/documentId` and `linker` nodes).
   */
  resolveInternalLink?: TiptapInternalLinkResolver;
}

const {
  type = "table",
  content = [],
  theme = TiptapBlockThemeDefault,
  resolveInternalLink,
} = Astro.props;
const tableClass = renderPropertyClasses(theme.table);
const headClass = getPropertyClass(theme.table.head);
const bodyClass = getPropertyClass(theme.table.body);
const rowClass = getPropertyClass(theme.table.row);
const headerCellClass = getPropertyClass(theme.table.headerCell);
const cellClass = getPropertyClass(theme.table.cell);

const hasHeaderRow =
  content.length > 0 && (content[0].content || []).every((cell) => cell.type === "tableHeader");
const sections = [
  { Tag: "thead", cls: headClass, rows: hasHeaderRow ? [content[0]] : [] },
  { Tag: "tbody", cls: bodyClass, rows: hasHeaderRow ? content.slice(1) : content },
].filter((section) => section.rows.length > 0);
const quoteClass = renderPropertyClasses(theme.quote);

const buildCellStyle = (cell: TiptapTableCellNode): string | undefined => {
  const parts: string[] = [];
  const bg = sanitizeCssColor(cell.attrs?.backgroundColor);
  if (bg) parts.push(`background-color: ${bg}`);
  if (
    Array.isArray(cell.attrs?.colwidth) &&
    cell.attrs.colwidth[0] &&
    Number(cell.attrs.colwidth[0]) > 0
  ) {
    parts.push(`width: ${Number(cell.attrs.colwidth[0])}px`);
  }
  return parts.length > 0 ? parts.join("; ") : undefined;
};
---

<table class:list={[tableClass || undefined]}>
  {sections.map(({ Tag, cls, rows }) => <Tag class:list={[cls || undefined]}>
    {rows.map((row) => <tr class:list={[rowClass || undefined]}>
      {(row.content || []).map((cell) => {
        const isHeader = cell.type === "tableHeader";
        const CellTag = isHeader ? "th" : "td";
        const siblings = cell.content || [];
        return <CellTag
          colspan={cell.attrs?.colspan && cell.attrs.colspan > 1 ? cell.attrs.colspan : undefined}
          rowspan={cell.attrs?.rowspan && cell.attrs.rowspan > 1 ? cell.attrs.rowspan : undefined}
          style={buildCellStyle(cell)}
          class:list={[(isHeader ? headerCellClass : cellClass) || undefined]}
        >
          {siblings.map((child) => {
            if (child.type === "paragraph" || child.type === "leadParagraph") {
              const inline = (
                <TiptapInlineNodes
                  nodes={child.content}
                  theme={theme.paragraph}
                  {resolveInternalLink}
                />
              );
              return siblings.length > 1 ? <p>{inline}</p> : inline;
            }
            if (
              child.type === "bulletList" ||
              child.type === "orderedList" ||
              child.type === "taskList"
            ) {
              return <TiptapBlockList {...child} {theme} {resolveInternalLink} />;
            }
            if (child.type === "codeBlock") {
              return <TiptapBlockCode {...child} {theme} />;
            }
            if (child.type === "heading") {
              return <TiptapBlockHeading {...child} {theme} {resolveInternalLink} />;
            }
            if (child.type === "image") {
              return <TiptapBlockImage {...child} {theme} />;
            }
            if (child.type === "horizontalRule" || child.type === "pageBreak") {
              return <TiptapBlockHr {...child} {theme} />;
            }
            if (child.type === "mathematics") {
              return <TiptapBlockMath {...child} {theme} />;
            }
            if (child.type === "blockquote") {
              return <blockquote class:list={[quoteClass || undefined]}>
                {(child.content || []).map((qChild) =>
                  qChild.type === "paragraph" || qChild.type === "leadParagraph" ? (
                    <p>
                      <TiptapInlineNodes
                        nodes={qChild.content}
                        theme={theme.paragraph}
                        {resolveInternalLink}
                      />
                    </p>
                  ) : null
                )}
              </blockquote>;
            }
            return null;
          })}
        </CellTag>;
      })}
    </tr>)}
  </Tag>)}
</table>
