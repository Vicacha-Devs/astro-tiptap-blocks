---
import { slugifyHeadingText } from "../../lib/sanitize";
import { getPropertyClass, renderPropertyClasses } from "../../lib/theme";
import type {
  TiptapBlockTheme,
  TiptapPageBreakNode,
  TiptapTableOfContentsNode,
} from "../../types";

type TocOrPageBreakProps = (TiptapTableOfContentsNode | TiptapPageBreakNode) & {
  theme: TiptapBlockTheme;
};

interface Props extends TocOrPageBreakProps {}

const props = Astro.props;
const { theme } = props;
const isPageBreak = props.type === "pageBreak";

const pageBreakClass = isPageBreak ? renderPropertyClasses(theme.pageBreak) : "";
const tocClass = !isPageBreak ? renderPropertyClasses(theme.tableOfContents) : "";
const tocTitleClass = getPropertyClass(theme.tableOfContents.title);
const tocListClass = getPropertyClass(theme.tableOfContents.list);
const tocItemClass = getPropertyClass(theme.tableOfContents.item);
const tocLinkClass = getPropertyClass(theme.tableOfContents.link);

const headings = !isPageBreak ? props.attrs?.headings || [] : [];
const title = !isPageBreak ? props.attrs?.title || "Table of Contents" : "";
---

{
  isPageBreak ? (
    <hr
      data-type="page-break"
      data-page-break="true"
      role="separator"
      aria-label="Page break"
      class:list={[pageBreakClass || undefined]}
    />
  ) : (
    headings.length > 0 && (
      <nav
        data-type="table-of-contents"
        aria-label={title}
        class:list={[tocClass || undefined]}
      >
        <div class:list={[tocTitleClass || undefined]}>{title}</div>
        <ol class:list={[tocListClass || undefined]}>
          {headings.map((item) => {
            const safeId = item.id || slugifyHeadingText(item.text);
            const indentStyle =
              item.level > 1 ? `padding-inline-start: ${(item.level - 1) * 0.75}rem` : undefined;
            return (
              <li style={indentStyle} class:list={[tocItemClass || undefined]}>
                <a href={`#${safeId}`} class:list={[tocLinkClass || undefined]}>
                  {item.text}
                </a>
              </li>
            );
          })}
        </ol>
      </nav>
    )
  )
}
