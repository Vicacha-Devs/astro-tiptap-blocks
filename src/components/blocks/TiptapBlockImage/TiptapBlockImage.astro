---
import { resolveTiptapMediaUrl } from "../../../lib/sanitize";
import {
  getPropertyClass,
  renderPropertyClasses,
  TiptapBlockThemeDefault,
} from "../../../lib/theme";
import type { TiptapBlockTheme, TiptapImageNode, TiptapMediaUrlResolver } from "../../../types";

/**
 * @component TiptapBlockImage
 * @title Tiptap Block Image
 * @description Renders a sanitized `<figure><img><figcaption>` image block supporting responsive `srcset`/`sizes`,
 * configurable `loading` (`lazy` | `eager`), `decoding`, `fetchpriority`, `mediaBaseUrl` resolution,
 * captions (`caption` or `title`), alignment (`data-align`), and asset metadata (`data-asset-id`, `data-document-id`).
 *
 * @preview
 *
 * <TiptapBlockImage
 *   attrs={{ src: "https://images.unsplash.com/photo-1518770660439-4636190af475?w=640", alt: "Circuit board", caption: "Figure 1" }}
 * />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import TiptapBlockImage from "@components/blocks/TiptapBlockImage/TiptapBlockImage.astro";
 * ---
 *
 * <TiptapBlockImage
 *   mediaBaseUrl="https://cms.mezquitabogota.org"
 *   attrs={{
 *     src: "/uploads/hero.webp",
 *     alt: "Hero banner",
 *     caption: "Caption text",
 *     "data-align": "center",
 *     "data-asset-id": 42,
 *   }}
 * />
 * ```
 */
export interface Props {
  /**
   * Discriminator node type.
   * @default "image"
   */
  type?: TiptapImageNode["type"];
  /**
   * Image attributes (`src`, `alt`, `title`, `caption`, `width`, `height`, `srcset`, `sizes`, `loading`, `decoding`, `fetchpriority`, `data-align`, `data-asset-id`, `data-document-id`).
   */
  attrs: TiptapImageNode["attrs"];
  /**
   * Resolved block theme object.
   * @default TiptapBlockThemeDefault
   */
  theme?: TiptapBlockTheme;
  /**
   * Optional media base URL prefixed to relative `/uploads/...` image URLs.
   */
  mediaBaseUrl?: string;
  /**
   * Optional custom resolver for image URLs before sanitization.
   */
  resolveMediaUrl?: TiptapMediaUrlResolver;
}

const {
  type = "image",
  attrs,
  theme = TiptapBlockThemeDefault,
  mediaBaseUrl,
  resolveMediaUrl,
} = Astro.props;
const safeSrc = resolveTiptapMediaUrl(attrs?.src, { mediaBaseUrl, resolveMediaUrl });
const alt = attrs?.alt || "";
const title = attrs?.title || undefined;
const captionText = attrs?.caption || attrs?.title || undefined;
const align = attrs?.["data-align"] || undefined;
const assetId = attrs?.["data-asset-id"] ?? undefined;
const documentId = attrs?.["data-document-id"] || undefined;
const loadingAttr = attrs?.loading === "eager" ? "eager" : "lazy";
const decodingAttr =
  attrs?.decoding && ["async", "sync", "auto"].includes(attrs.decoding) ? attrs.decoding : "async";
const fetchPriorityAttr =
  attrs?.fetchpriority && ["high", "low", "auto"].includes(attrs.fetchpriority)
    ? attrs.fetchpriority
    : undefined;

const alignClass =
  align === "center" ? "mx-auto text-center" : align === "right" ? "ms-auto text-end" : "";
const figureClass = [renderPropertyClasses(theme.image), alignClass]
  .filter(Boolean)
  .join(" ")
  .trim();
const imgClass = getPropertyClass(theme.image.image);
const captionClass = getPropertyClass(theme.image.caption);
---

{safeSrc !== "#" && <figure
  data-align={align}
  data-asset-id={assetId !== undefined ? String(assetId) : undefined}
  data-document-id={documentId}
  class:list={[figureClass || undefined]}
>
  <img
    src={safeSrc}
    srcset={attrs?.srcset || undefined}
    sizes={attrs?.sizes || undefined}
    {alt}
    {title}
    width={attrs?.width || undefined}
    height={attrs?.height || undefined}
    loading={loadingAttr}
    decoding={decodingAttr}
    fetchpriority={fetchPriorityAttr}
    class:list={[imgClass || undefined]}
  />
  {captionText && <figcaption class:list={[captionClass || undefined]}>{captionText}</figcaption>}
</figure>}
