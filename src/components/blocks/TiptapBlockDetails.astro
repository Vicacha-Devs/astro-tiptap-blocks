---
import { getPropertyClass, renderPropertyClasses } from "../../lib/theme";
import type {
  TiptapBlockNode,
  TiptapBlockTheme,
  TiptapDetailsContentNode,
  TiptapDetailsNode,
  TiptapDetailsSummaryNode,
} from "../../types";
import TiptapInlineNodes from "./items/TiptapInlineNodes.astro";
import TiptapNestedBlocks from "./items/TiptapNestedBlocks.astro";

interface Props extends TiptapDetailsNode {
  theme: TiptapBlockTheme;
}

const { attrs, content = [], theme } = Astro.props;
const detailsClass = renderPropertyClasses(theme.details);
const summaryClass = getPropertyClass(theme.details.summary);
const contentClass = getPropertyClass(theme.details.content);

const summaryNode = content.find(
  (child): child is TiptapDetailsSummaryNode => child.type === "detailsSummary"
);
const detailsContentNode = content.find(
  (child): child is TiptapDetailsContentNode => child.type === "detailsContent"
);
const bodyBlocks: TiptapBlockNode[] = detailsContentNode
  ? detailsContentNode.content || []
  : (content.filter(
      (child) => child.type !== "detailsSummary" && child.type !== "detailsContent"
    ) as TiptapBlockNode[]);
---

<details
  open={attrs?.open ? true : undefined}
  class:list={[detailsClass || undefined]}
>
  <summary class:list={[summaryClass || undefined]}>
    {
      summaryNode && summaryNode.content && summaryNode.content.length > 0 ? (
        <TiptapInlineNodes nodes={summaryNode.content} theme={theme.paragraph} />
      ) : (
        "Details"
      )
    }
  </summary>
  <div data-type="details-content" class:list={[contentClass || undefined]}>
    <TiptapNestedBlocks blocks={bodyBlocks} theme={theme} />
  </div>
</details>
