---
import { getPropertyClass, renderPropertyClasses, TiptapBlockThemeDefault } from "../../../lib/theme";
import type { TiptapBlockTheme, TiptapCodeBlockNode, TiptapTextNode } from "../../../types";

/**
 * @component TiptapBlockCode
 * @title Tiptap Block Code
 * @description Renders a `<pre><code>` fenced code block with optional `data-language` / `language-*` class,
 * per-line `<span>` wrappers with `data-line-number`, and an optional header toolbar with language badge and copy button.
 *
 * @preview
 *
 * <TiptapBlockCode attrs={{ language: "ts" }} content={[{ type: "text", text: "const x: number = 42;" }]} />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import TiptapBlockCode from "@components/blocks/TiptapBlockCode/TiptapBlockCode.astro";
 * ---
 *
 * <TiptapBlockCode
 *   showLineNumbers
 *   copyable
 *   attrs={{ language: "typescript" }}
 *   content={[{ type: "text", text: "export const hello = () => 'world';" }]}
 * />
 * ```
 */
export interface Props {
  /**
   * Discriminator node type.
   * @default "codeBlock"
   */
  type?: TiptapCodeBlockNode["type"];
  /**
   * Code block attributes (`language`, `showLineNumbers`, `copyable`).
   */
  attrs?: TiptapCodeBlockNode["attrs"];
  /**
   * Plain text nodes containing the source code.
   * @default []
   */
  content?: Array<TiptapTextNode>;
  /**
   * Resolved block theme object.
   * @default TiptapBlockThemeDefault
   */
  theme?: TiptapBlockTheme;
  /**
   * Adds `data-line-number` attributes and line numbers to each code line.
   * @default false
   */
  showLineNumbers?: boolean;
  /**
   * Renders a header bar with language badge and a copy-to-clipboard button (`data-copy-code`).
   * @default false
   */
  copyable?: boolean;
}

const {
  type = "codeBlock",
  attrs,
  content = [],
  theme = TiptapBlockThemeDefault,
  showLineNumbers = false,
  copyable = false,
} = Astro.props;
const language = attrs?.language || undefined;
const withLineNumbers = Boolean(showLineNumbers || attrs?.showLineNumbers);
const isCopyable = Boolean(copyable || attrs?.copyable);
const preClassName = renderPropertyClasses(theme.code);
const lineClassName = getPropertyClass(theme.code.line);
const rawCode = content.map((node) => node.text).join("");
const lines = rawCode ? rawCode.split("\n") : [];
---

{
  isCopyable ? (
    <div class="tiptap-code-wrapper my-4">
      <div class="flex items-center justify-between rounded-t-lg border border-b-0 border-slate-700 bg-slate-800 px-4 py-1.5 text-xs text-slate-300">
        <span class="font-mono uppercase tracking-wider">{language || "code"}</span>
        <button
          type="button"
          data-copy-code={rawCode}
          aria-label="Copy code to clipboard"
          class="rounded bg-slate-700 px-2 py-0.5 font-medium text-slate-200 hover:bg-slate-600"
        >
          Copy
        </button>
      </div>
      <pre class:list={[preClassName || undefined, "!my-0 !rounded-t-none"]} data-language={language}>
        <code class:list={[language ? `language-${language}` : undefined]}>
          {lines.map((line, idx) => (
            <span
              data-line-number={withLineNumbers ? idx + 1 : undefined}
              class:list={[lineClassName || undefined]}
            >
              {line}
              {"\n"}
            </span>
          ))}
        </code>
      </pre>
    </div>
  ) : (
    <pre class:list={[preClassName || undefined]} data-language={language}>
      <code class:list={[language ? `language-${language}` : undefined]}>
        {lines.map((line, idx) => (
          <span
            data-line-number={withLineNumbers ? idx + 1 : undefined}
            class:list={[lineClassName || undefined]}
          >
            {line}
            {"\n"}
          </span>
        ))}
      </code>
    </pre>
  )
}
