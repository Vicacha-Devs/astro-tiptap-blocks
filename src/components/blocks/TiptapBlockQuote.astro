---
import { renderPropertyClasses } from "../../lib/theme";
import type { TiptapBlockquoteNode, TiptapBlockTheme } from "../../types";
import TiptapNestedBlocks from "./items/TiptapNestedBlocks.astro";

interface Props extends TiptapBlockquoteNode {
  theme: TiptapBlockTheme;
}

const { attrs, content = [], theme } = Astro.props;
const quoteClass = renderPropertyClasses(theme.quote);
const textAlignStyle =
  attrs?.textAlign && ["left", "center", "right", "justify"].includes(attrs.textAlign)
    ? `text-align: ${attrs.textAlign}`
    : undefined;
const dirAttr = attrs?.dir || undefined;
---

<blockquote dir={dirAttr} style={textAlignStyle} class:list={[quoteClass || undefined]}>
  <TiptapNestedBlocks blocks={content} theme={theme} />
</blockquote>
