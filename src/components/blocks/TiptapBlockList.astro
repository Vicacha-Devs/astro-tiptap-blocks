---
import { getPropertyClass, renderPropertyClasses } from "../../lib/theme";
import type {
  TiptapBlockTheme,
  TiptapBulletListNode,
  TiptapOrderedListNode,
  TiptapTaskItemNode,
  TiptapTaskListNode,
} from "../../types";
import TiptapInlineNodes from "./items/TiptapInlineNodes.astro";

type ListNode = TiptapBulletListNode | TiptapOrderedListNode | TiptapTaskListNode;

interface Props extends ListNode {
  theme: TiptapBlockTheme;
}

const { type, attrs, content = [], theme } = Astro.props;
const isOrdered = type === "orderedList";
const isTask = type === "taskList";
const ListTag = isOrdered ? "ol" : "ul";
const listClass = isTask
  ? renderPropertyClasses(theme.taskList)
  : renderPropertyClasses(theme.list, isOrdered ? "ordered" : "unordered");
const itemClass = isTask
  ? getPropertyClass(theme.taskList.item)
  : getPropertyClass(theme.list.item);
const checkboxClass = getPropertyClass(theme.taskList.checkbox);
const taskContentClass = getPropertyClass(theme.taskList.content);
const taskCheckedClass = getPropertyClass(theme.taskList.checked);
const startAttr =
  isOrdered && attrs && "start" in attrs && attrs.start && attrs.start > 1
    ? attrs.start
    : undefined;
---

<ListTag
  start={startAttr}
  data-type={isTask ? "taskList" : undefined}
  class:list={[listClass || undefined]}
>
  {
    content.map((item) => {
      const isTaskItem = item.type === "taskItem";
      const checked = isTaskItem ? Boolean((item as TiptapTaskItemNode).attrs?.checked) : false;
      const bodyClass = [taskContentClass, checked ? taskCheckedClass : ""]
        .filter(Boolean)
        .join(" ")
        .trim();

      return (
        <li
          data-type={isTaskItem ? "taskItem" : undefined}
          data-checked={isTaskItem ? String(checked) : undefined}
          class:list={[itemClass || undefined]}
        >
          {isTaskItem && (
            <input
              type="checkbox"
              checked={checked ? true : undefined}
              disabled
              aria-readonly="true"
              class:list={[checkboxClass || undefined]}
            />
          )}
          <div class:list={[isTaskItem ? bodyClass || undefined : undefined]}>
            {(item.content || []).map((child) => {
              if (child.type === "paragraph") {
                return <TiptapInlineNodes nodes={child.content} theme={theme.paragraph} />;
              }
              if (child.type === "bulletList" || child.type === "orderedList" || child.type === "taskList") {
                const SubListTag = child.type === "orderedList" ? "ol" : "ul";
                const subListClass =
                  child.type === "taskList"
                    ? renderPropertyClasses(theme.taskList)
                    : renderPropertyClasses(theme.list, child.type === "orderedList" ? "ordered" : "unordered");
                return (
                  <SubListTag class:list={[subListClass || undefined]}>
                    {(child.content || []).map((subItem) => (
                      <li class:list={[itemClass || undefined]}>
                        {(subItem.content || []).map((subChild) =>
                          subChild.type === "paragraph" ? (
                            <TiptapInlineNodes nodes={subChild.content} theme={theme.paragraph} />
                          ) : null
                        )}
                      </li>
                    ))}
                  </SubListTag>
                );
              }
              return null;
            })}
          </div>
        </li>
      );
    })
  }
</ListTag>
