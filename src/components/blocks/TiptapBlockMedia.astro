---
import { formatFileSize, sanitizeTiptapIframeUrl, sanitizeTiptapUrl } from "../../lib/sanitize";
import { getPropertyClass, renderPropertyClasses } from "../../lib/theme";
import type {
  TiptapAttachmentNode,
  TiptapAudioNode,
  TiptapBlockTheme,
  TiptapIframeNode,
  TiptapVideoNode,
} from "../../types";

type MediaProps = (TiptapVideoNode | TiptapAudioNode | TiptapAttachmentNode | TiptapIframeNode) & {
  theme: TiptapBlockTheme;
  allowedIframeDomains?: ReadonlyArray<string>;
};

interface Props extends MediaProps {}

const props = Astro.props;
const { theme, allowedIframeDomains } = props;
---

{
  props.type === "video" &&
    (() => {
      const { attrs } = props;
      const isEmbed = attrs?.embedType === "embed" || /youtube\.com|youtu\.be|vimeo\.com/i.test(attrs?.src || "");
      const safeSrc = isEmbed
        ? sanitizeTiptapIframeUrl(attrs?.src, allowedIframeDomains)
        : sanitizeTiptapUrl(attrs?.src);
      if (safeSrc === "#") return null;
      const caption = attrs?.caption || attrs?.title || undefined;
      const figureClass = renderPropertyClasses(theme.video);
      const videoClass = getPropertyClass(theme.video.video);
      const iframeClass = getPropertyClass(theme.video.iframe);
      const captionClass = getPropertyClass(theme.video.caption);
      return (
        <figure
          data-type="video"
          data-embed-type={isEmbed ? "embed" : "file"}
          data-align={attrs?.["data-align"] || undefined}
          data-asset-id={attrs?.["data-asset-id"] !== undefined && attrs?.["data-asset-id"] !== null ? String(attrs["data-asset-id"]) : undefined}
          data-document-id={attrs?.["data-document-id"] || undefined}
          class:list={[figureClass || undefined]}
        >
          {isEmbed ? (
            <iframe
              src={safeSrc}
              title={attrs?.title || caption || "Embedded video"}
              width={attrs?.width || "100%"}
              height={attrs?.height || 400}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              sandbox="allow-scripts allow-same-origin allow-presentation"
              referrerpolicy="no-referrer"
              class:list={[iframeClass || undefined]}
            />
          ) : (
            <video
              controls
              preload="metadata"
              src={safeSrc}
              title={attrs?.title || undefined}
              width={attrs?.width || undefined}
              height={attrs?.height || undefined}
              class:list={[videoClass || undefined]}
            />
          )}
          {caption && <figcaption class:list={[captionClass || undefined]}>{caption}</figcaption>}
        </figure>
      );
    })()
}

{
  props.type === "audio" &&
    (() => {
      const { attrs } = props;
      const safeSrc = sanitizeTiptapUrl(attrs?.src);
      if (safeSrc === "#") return null;
      const caption = attrs?.caption || attrs?.title || undefined;
      const figureClass = renderPropertyClasses(theme.audio);
      const audioClass = getPropertyClass(theme.audio.audio);
      const captionClass = getPropertyClass(theme.audio.caption);
      return (
        <figure
          data-type="audio"
          data-align={attrs?.["data-align"] || undefined}
          data-asset-id={attrs?.["data-asset-id"] !== undefined && attrs?.["data-asset-id"] !== null ? String(attrs["data-asset-id"]) : undefined}
          data-document-id={attrs?.["data-document-id"] || undefined}
          class:list={[figureClass || undefined]}
        >
          <audio controls preload="metadata" src={safeSrc} title={attrs?.title || undefined} class:list={[audioClass || undefined]} />
          {caption && <figcaption class:list={[captionClass || undefined]}>{caption}</figcaption>}
        </figure>
      );
    })()
}

{
  props.type === "attachment" &&
    (() => {
      const { attrs } = props;
      const safeHref = sanitizeTiptapUrl(attrs?.href);
      if (safeHref === "#") return null;
      const filename = attrs?.filename || attrs?.title || "Attachment";
      const title = attrs?.title || filename;
      const ext = (attrs?.ext || filename.split(".").pop() || "FILE").replace(/^\./, "").toUpperCase();
      const sizeStr = formatFileSize(attrs?.size);
      const metaText = [ext, sizeStr].filter(Boolean).join(" • ");
      const cardClass = renderPropertyClasses(theme.attachment);
      return (
        <div
          data-type="attachment"
          data-asset-id={attrs?.["data-asset-id"] !== undefined && attrs?.["data-asset-id"] !== null ? String(attrs["data-asset-id"]) : undefined}
          data-document-id={attrs?.["data-document-id"] || undefined}
          class:list={[cardClass || undefined]}
        >
          <div class="flex items-center gap-3 min-w-0">
            <span class:list={[getPropertyClass(theme.attachment.badge) || undefined]}>{ext}</span>
            <div class="min-w-0">
              <div class:list={[getPropertyClass(theme.attachment.title) || undefined]}>{title}</div>
              {metaText && <div class:list={[getPropertyClass(theme.attachment.meta) || undefined]}>{metaText}</div>}
            </div>
          </div>
          <a
            href={safeHref}
            download={filename}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[getPropertyClass(theme.attachment.button) || undefined]}
          >
            Download
          </a>
        </div>
      );
    })()
}

{
  props.type === "iframe" &&
    (() => {
      const { attrs } = props;
      const safeSrc = sanitizeTiptapIframeUrl(attrs?.src, allowedIframeDomains);
      if (safeSrc === "#") return null;
      const wrapperClass = renderPropertyClasses(theme.iframe);
      const iframeClass = getPropertyClass(theme.iframe.iframe);
      return (
        <div data-type="iframe-wrapper" data-align={attrs?.["data-align"] || undefined} class:list={[wrapperClass || undefined]}>
          <iframe
            src={safeSrc}
            title={attrs?.title || "Embedded content"}
            width={attrs?.width || "100%"}
            height={attrs?.height || 400}
            loading="lazy"
            sandbox="allow-scripts allow-same-origin allow-popups"
            referrerpolicy="no-referrer"
            class:list={[iframeClass || undefined]}
          />
        </div>
      );
    })()
}
