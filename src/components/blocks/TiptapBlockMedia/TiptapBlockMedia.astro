---
import {
  formatFileSize,
  isTrustedMediaEmbedUrl,
  resolveTiptapMediaUrl,
  sanitizeTiptapIframeUrl,
} from "../../../lib/sanitize";
import {
  getPropertyClass,
  renderPropertyClasses,
  TiptapBlockThemeDefault,
} from "../../../lib/theme";
import type {
  TiptapBlockTheme,
  TiptapMediaBlockAttrs,
  TiptapMediaUrlResolver,
} from "../../../types";

/**
 * @component TiptapBlockMedia
 * @title Tiptap Block Media & Sandboxed Embeds
 * @description Renders rich media (`video`, `audio`, `attachment`) and HTTPS-only sandboxed `iframe` embeds.
 *
 * @preview
 * <TiptapBlockMedia type="attachment" attrs={{ href: "/files/guide.pdf", title: "User Guide", size: 1048576, ext: "pdf" }} />
 *
 * @usage
 * ```astro nocollapse
 * ---
 * import TiptapBlockMedia from "@components/blocks/TiptapBlockMedia/TiptapBlockMedia.astro";
 * ---
 * <TiptapBlockMedia type="video" attrs={{ src: "https://www.youtube.com/embed/dQw4w9WgXcQ", embedType: "embed", title: "Demo" }} />
 * ```
 */
export interface Props {
  /** Media/embed block type (`"video"`, `"audio"`, `"attachment"`, or `"iframe"`). */
  type: "video" | "audio" | "attachment" | "iframe";
  /** Media/embed attributes (`src`, `href`, `embedType`, `title`, `caption`, `filename`, `size`, `ext`, `width`, `height`, `data-align`, `data-asset-id`, `data-document-id`). */
  attrs: TiptapMediaBlockAttrs;
  /** Resolved block theme object. @default TiptapBlockThemeDefault */
  theme?: TiptapBlockTheme;
  /** Optional domain allowlist for HTTPS `<iframe>` and video embeds. */
  allowedIframeDomains?: ReadonlyArray<string>;
  /** Optional media base URL prefixed to relative `/uploads/...` media URLs. */
  mediaBaseUrl?: string;
  /** Optional custom resolver for media URLs (`video`, `audio`, `attachment`) before sanitization. */
  resolveMediaUrl?: TiptapMediaUrlResolver;
}

const {
  type,
  attrs,
  theme = TiptapBlockThemeDefault,
  allowedIframeDomains,
  mediaBaseUrl,
  resolveMediaUrl,
} = Astro.props;
const align = attrs?.["data-align"] || undefined;
const assetId = attrs?.["data-asset-id"] != null ? String(attrs["data-asset-id"]) : undefined;
const documentId = attrs?.["data-document-id"] || undefined;
const mediaOpts = { mediaBaseUrl, resolveMediaUrl };
---

{(() => {
  if (type === "video") {
    const isEmbed =
      attrs?.embedType === "embed" ||
      Boolean(attrs?.src && /youtube\.com|youtu\.be|vimeo\.com/i.test(attrs.src));
    const safeSrc = isEmbed
      ? sanitizeTiptapIframeUrl(attrs?.src, allowedIframeDomains)
      : resolveTiptapMediaUrl(attrs?.src, mediaOpts);
    if (safeSrc === "#") return null;
    const videoSandbox = isTrustedMediaEmbedUrl(safeSrc)
      ? "allow-scripts allow-same-origin allow-presentation"
      : "allow-scripts allow-presentation";
    return <figure
      data-type="video"
      data-align={align}
      data-asset-id={assetId}
      data-document-id={documentId}
      class:list={[renderPropertyClasses(theme.video) || undefined]}
    >
      {isEmbed ? (
        <iframe
          src={safeSrc}
          title={attrs?.title || "Embedded video"}
          width={attrs?.width || undefined}
          height={attrs?.height || undefined}
          loading="lazy"
          sandbox={videoSandbox}
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          class:list={[getPropertyClass(theme.video.iframe) || undefined]}
        />
      ) : (
        <video
          src={safeSrc}
          controls
          preload="metadata"
          width={attrs?.width || undefined}
          height={attrs?.height || undefined}
          class:list={[getPropertyClass(theme.video.video) || undefined]}
        />
      )}
      {attrs?.caption && <figcaption
        class:list={[getPropertyClass(theme.video.caption) || undefined]}
      >
        {attrs.caption}
      </figcaption>}
    </figure>;
  }

  if (type === "audio") {
    const safeSrc = resolveTiptapMediaUrl(attrs?.src, mediaOpts);
    if (safeSrc === "#") return null;
    return <figure
      data-type="audio"
      data-align={align}
      data-asset-id={assetId}
      data-document-id={documentId}
      class:list={[renderPropertyClasses(theme.audio) || undefined]}
    >
      <audio
        src={safeSrc}
        controls
        preload="metadata"
        class:list={[getPropertyClass(theme.audio.audio) || undefined]}
      />
      {(attrs?.caption || attrs?.title) && <figcaption
        class:list={[getPropertyClass(theme.audio.caption) || undefined]}
      >
        {attrs.caption || attrs.title}
      </figcaption>}
    </figure>;
  }

  if (type === "attachment") {
    const safeHref = resolveTiptapMediaUrl(attrs?.href || attrs?.src, mediaOpts);
    if (safeHref === "#") return null;
    const displayTitle = attrs?.title || attrs?.filename || "Download file";
    const formattedSize = formatFileSize(attrs?.size);
    const extLabel = (attrs?.ext || "").replace(/^\./, "").toUpperCase() || "FILE";
    return <div
      data-type="attachment"
      data-asset-id={assetId}
      data-document-id={documentId}
      class:list={[renderPropertyClasses(theme.attachment) || undefined]}
    >
      <div class="flex items-center gap-3 min-w-0">
        <span class:list={[getPropertyClass(theme.attachment.badge) || undefined]}>{extLabel}</span>
        <div class="min-w-0">
          <div class:list={[getPropertyClass(theme.attachment.title) || undefined]}>
            {displayTitle}
          </div>
          {formattedSize && <div
            class:list={[getPropertyClass(theme.attachment.meta) || undefined]}
          >
            {formattedSize}
          </div>}
        </div>
      </div>
      <a
        href={safeHref}
        download={attrs?.filename || true}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[getPropertyClass(theme.attachment.button) || undefined]}
        >Download</a
      >
    </div>;
  }

  const safeIframeSrc = sanitizeTiptapIframeUrl(attrs?.src, allowedIframeDomains);
  if (safeIframeSrc === "#") return null;
  const iframeSandbox = isTrustedMediaEmbedUrl(safeIframeSrc)
    ? "allow-scripts allow-same-origin allow-presentation allow-popups"
    : "allow-scripts allow-presentation allow-popups";
  return <div
    data-type="iframe"
    data-align={align}
    class:list={[renderPropertyClasses(theme.iframe) || undefined]}
  >
    <iframe
      src={safeIframeSrc}
      title={attrs?.title || "Embedded content"}
      width={attrs?.width || "100%"}
      height={attrs?.height || "400"}
      loading="lazy"
      sandbox={iframeSandbox}
      referrerpolicy="strict-origin-when-cross-origin"
      class:list={[getPropertyClass(theme.iframe.iframe) || undefined]}
    />
  </div>;
})()}
