---
import { formatLatexPreview } from "../../lib/sanitize";
import { getPropertyClass, renderPropertyClasses } from "../../lib/theme";
import type { TiptapBlockTheme, TiptapMathematicsNode } from "../../types";

interface Props extends TiptapMathematicsNode {
  theme: TiptapBlockTheme;
}

const { attrs, theme } = Astro.props;
const latex = attrs?.latex || "";
const wrapperClass = renderPropertyClasses(theme.mathematics);
const formulaClass = getPropertyClass(theme.mathematics.formula);
---

<div
  data-type="mathematics"
  data-latex={latex}
  data-display-mode="block"
  role="math"
  aria-label={latex}
  class:list={[wrapperClass || undefined]}
>
  <code class:list={[formulaClass || undefined]}>{formatLatexPreview(latex)}</code>
</div>
