---
import { parseTiptapContent } from "../../lib/parser";
import {
  buildThemeObject,
  getPropertyClass,
  mapNodeTypeToThemeKey,
  TiptapBlockThemeDefault,
} from "../../lib/theme";
import type {
  TiptapBlockThemeCustomComponents,
  TiptapBlockUserComponents,
  TiptapBlockUserTheme,
  TiptapContentInput,
  TiptapInternalLinkResolver,
  TiptapMediaUrlResolver,
} from "../../types";
import TiptapNestedBlocks from "../blocks/items/TiptapNestedBlocks/TiptapNestedBlocks.astro";
import TiptapBlockCallout from "../blocks/TiptapBlockCallout/TiptapBlockCallout.astro";
import TiptapBlockColumns from "../blocks/TiptapBlockColumns/TiptapBlockColumns.astro";
import TiptapBlockCustom from "../blocks/TiptapBlockCustom/TiptapBlockCustom.astro";
import TiptapBlockDetails from "../blocks/TiptapBlockDetails/TiptapBlockDetails.astro";
import TiptapBlockQuote from "../blocks/TiptapBlockQuote/TiptapBlockQuote.astro";

/**
 * @component TiptapBlocks
 * @title Tiptap Blocks Renderer
 * @description Root orchestrator component that parses Tiptap/ProseMirror JSON, HTML, or Markdown content
 * into a sanitized `TiptapDocNode` AST and renders each block using native, themeable Astro components.
 *
 * @preview
 * <TiptapBlocks data={{ type: "doc", content: [{ type: "paragraph", content: [{ type: "text", text: "Hello Astro!" }] }] }} />
 *
 * @usage
 * ```astro nocollapse
 * ---
 * import { TiptapBlocks } from "@vicacha-devs/astro-tiptap-blocks";
 * ---
 * <TiptapBlocks
 *   data={article.body}
 *   mediaBaseUrl="https://cms.mezquitabogota.org"
 *   allowedIframeDomains={["youtube.com", "player.vimeo.com"]}
 *   resolveInternalLink={({ collectionName, documentId }) => `/${collectionName}/${documentId}`}
 * />
 * ```
 */
export interface Props {
  /** Tiptap content input: ProseMirror JSON (`TiptapDocNode` or `TiptapBlockNode[]`), JSON string, HTML string, Markdown string, or `string[]`. */
  data: TiptapContentInput;
  /** Optional user theme configuration (`extend` or `overwrite`) merged over `TiptapBlockThemeDefault`. */
  theme?: TiptapBlockUserTheme;
  /** Optional map of custom Astro components overriding specific block types (`heading`, `paragraph`, `quote`, etc.). @default {} */
  blocks?: TiptapBlockUserComponents;
  /** Optional CSS class names appended to the root container `<div>`. @default "" */
  class?: string;
  /** Optional domain allowlist for HTTPS `<iframe>` and video embeds (e.g. `["youtube.com", "player.vimeo.com"]`). */
  allowedIframeDomains?: ReadonlyArray<string>;
  /** Optional callback to resolve internal links (`tiptap://collectionName/documentId` and `linker` nodes) into frontend URLs. */
  resolveInternalLink?: TiptapInternalLinkResolver;
  /** Optional media base URL prefixed to relative `/uploads/...` media URLs. */
  mediaBaseUrl?: string;
  /** Optional custom resolver for media URLs (`image`, `video`, `audio`, `attachment`) before sanitization. */
  resolveMediaUrl?: TiptapMediaUrlResolver;
  /** Renders an accessible `#` permalink anchor inside headings (`h1`–`h6`). @default false */
  headingAnchors?: boolean;
  /** Adds `data-line-number` attributes to code block lines. @default false */
  showCodeLineNumbers?: boolean;
  /** Renders a header bar with language badge and copy button on code blocks. @default false */
  copyableCodeBlocks?: boolean;
}

const {
  data,
  theme: userTheme,
  blocks: customBlocks = {},
  class: className = "",
  allowedIframeDomains,
  resolveInternalLink,
  mediaBaseUrl,
  resolveMediaUrl,
  headingAnchors = false,
  showCodeLineNumbers = false,
  copyableCodeBlocks = false,
} = Astro.props;

const doc = parseTiptapContent(data, {
  allowedIframeDomains,
  resolveInternalLink,
  mediaBaseUrl,
  resolveMediaUrl,
});
const theme = buildThemeObject(userTheme, TiptapBlockThemeDefault);
const wrapperClass = [getPropertyClass(theme.default), className].filter(Boolean).join(" ").trim();
const contextProps = {
  customBlocks,
  headingAnchors,
  showCodeLineNumbers,
  copyableCodeBlocks,
  mediaBaseUrl,
  resolveMediaUrl,
  allowedIframeDomains,
  resolveInternalLink,
};
---

<div class:list={[wrapperClass || undefined]}>
  {doc.content.map((block) => {
    const themeKey = mapNodeTypeToThemeKey(block.type) as keyof TiptapBlockThemeCustomComponents;
    const customComponent = customBlocks[themeKey] ?? customBlocks[block.type];
    if (customComponent) {
      return <TiptapBlockCustom component={customComponent} {...block} {theme} />;
    }
    switch (block.type) {
      case "blockquote":
        return <TiptapBlockQuote {...block} {theme} {...contextProps} />;
      case "informationPane":
      case "conversationHistory":
        return <TiptapBlockCallout {...block} {theme} {...contextProps} />;
      case "details":
        return <TiptapBlockDetails {...block} {theme} {...contextProps} />;
      case "layoutContainer":
        return <TiptapBlockColumns {...block} {theme} {...contextProps} />;
      default:
        return <TiptapNestedBlocks blocks={[block]} {theme} {...contextProps} />;
    }
  })}
</div>
