---
import { parseTiptapContent } from "../../lib/parser";
import { buildThemeObject, getPropertyClass, TiptapBlockThemeDefault } from "../../lib/theme";
import type {
  TiptapBlockNode,
  TiptapBlockThemeCustomComponents,
  TiptapBlockUserComponents,
  TiptapBlockUserTheme,
  TiptapContentInput,
  TiptapInternalLinkResolver,
} from "../../types";

import TiptapBlockCallout from "../blocks/TiptapBlockCallout/TiptapBlockCallout.astro";
import TiptapBlockCode from "../blocks/TiptapBlockCode/TiptapBlockCode.astro";
import TiptapBlockColumns from "../blocks/TiptapBlockColumns/TiptapBlockColumns.astro";
import TiptapBlockCustom from "../blocks/TiptapBlockCustom/TiptapBlockCustom.astro";
import TiptapBlockDetails from "../blocks/TiptapBlockDetails/TiptapBlockDetails.astro";
import TiptapBlockHeading from "../blocks/TiptapBlockHeading/TiptapBlockHeading.astro";
import TiptapBlockHr from "../blocks/TiptapBlockHr/TiptapBlockHr.astro";
import TiptapBlockImage from "../blocks/TiptapBlockImage/TiptapBlockImage.astro";
import TiptapBlockList from "../blocks/TiptapBlockList/TiptapBlockList.astro";
import TiptapBlockMath from "../blocks/TiptapBlockMath/TiptapBlockMath.astro";
import TiptapBlockMedia from "../blocks/TiptapBlockMedia/TiptapBlockMedia.astro";
import TiptapBlockParagraph from "../blocks/TiptapBlockParagraph/TiptapBlockParagraph.astro";
import TiptapBlockQuote from "../blocks/TiptapBlockQuote/TiptapBlockQuote.astro";
import TiptapBlockTable from "../blocks/TiptapBlockTable/TiptapBlockTable.astro";
import TiptapBlockToc from "../blocks/TiptapBlockToc/TiptapBlockToc.astro";

/**
 * @component TiptapBlocks
 * @title Tiptap Blocks Renderer
 * @description Root orchestrator component that parses Tiptap/ProseMirror JSON, HTML, or Markdown content
 * into a sanitized `TiptapDocNode` AST and renders each block using native, themeable Astro components.
 *
 * @preview
 *
 * <TiptapBlocks data={{ type: "doc", content: [{ type: "paragraph", content: [{ type: "text", text: "Hello Astro!" }] }] }} />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import { TiptapBlocks } from "@vicacha-devs/astro-tiptap-blocks";
 * ---
 *
 * <TiptapBlocks
 *   data={article.body}
 *   allowedIframeDomains={["youtube.com", "player.vimeo.com"]}
 *   resolveInternalLink={({ collectionName, documentId }) => `/${collectionName}/${documentId}`}
 * />
 * ```
 *
 * @examples
 *
 * ### Extending the Default Theme
 *
 * ```astro nocollapse
 * <TiptapBlocks
 *   data={article.body}
 *   theme={{ extend: { heading: { h2: "text-3xl font-extrabold" } } }}
 * />
 * ```
 */
export interface Props {
  /**
   * Tiptap content input: ProseMirror JSON (`TiptapDocNode` or `TiptapBlockNode[]`), JSON string, HTML string, Markdown string, or `string[]`.
   */
  data: TiptapContentInput;
  /**
   * Optional user theme configuration (`extend` or `overwrite`) merged over `TiptapBlockThemeDefault`.
   */
  theme?: TiptapBlockUserTheme;
  /**
   * Optional map of custom Astro components overriding specific block types (`heading`, `paragraph`, `quote`, etc.).
   * @default {}
   */
  blocks?: TiptapBlockUserComponents;
  /**
   * Optional CSS class names appended to the root container `<div>`.
   * @default ""
   */
  class?: string;
  /**
   * Optional domain allowlist for HTTPS `<iframe>` and video embeds (e.g. `["youtube.com", "player.vimeo.com"]`).
   */
  allowedIframeDomains?: ReadonlyArray<string>;
  /**
   * Optional callback to resolve Strapi internal links (`strapi://collectionName/documentId` and `linker` nodes) into frontend URLs.
   */
  resolveInternalLink?: TiptapInternalLinkResolver;
}

const {
  data,
  theme: userTheme,
  blocks: customBlocks = {},
  class: className = "",
  allowedIframeDomains,
  resolveInternalLink,
} = Astro.props;

const doc = parseTiptapContent(data, { allowedIframeDomains, resolveInternalLink });
const theme = buildThemeObject(userTheme, TiptapBlockThemeDefault);
const wrapperClass = [getPropertyClass(theme.default), className].filter(Boolean).join(" ").trim();

const mapNodeTypeToThemeKey = (
  nodeType: TiptapBlockNode["type"]
): keyof TiptapBlockThemeCustomComponents => {
  switch (nodeType) {
    case "heading": return "heading";
    case "paragraph": return "paragraph";
    case "leadParagraph": return "leadParagraph";
    case "blockquote": return "quote";
    case "informationPane": return "informationPane";
    case "conversationHistory": return "conversationHistory";
    case "details": return "details";
    case "layoutContainer": return "columns";
    case "bulletList":
    case "orderedList": return "list";
    case "taskList": return "taskList";
    case "codeBlock": return "code";
    case "image": return "image";
    case "video": return "video";
    case "audio": return "audio";
    case "attachment": return "attachment";
    case "iframe": return "iframe";
    case "mathematics": return "mathematics";
    case "tableOfContents": return "tableOfContents";
    case "pageBreak": return "pageBreak";
    case "table": return "table";
    case "horizontalRule": return "hr";
  }
};
---

<div class:list={[wrapperClass || undefined]}>
  {
    doc.content.map((block) => {
      const themeKey = mapNodeTypeToThemeKey(block.type);
      const customComponent = customBlocks[themeKey];
      if (customComponent) {
        return <TiptapBlockCustom component={customComponent} {...block} theme={theme} />;
      }
      switch (block.type) {
        case "heading":
          return <TiptapBlockHeading {...block} theme={theme} />;
        case "paragraph":
        case "leadParagraph":
          return <TiptapBlockParagraph {...block} theme={theme} />;
        case "blockquote":
          return <TiptapBlockQuote {...block} theme={theme} />;
        case "informationPane":
        case "conversationHistory":
          return <TiptapBlockCallout {...block} theme={theme} />;
        case "details":
          return <TiptapBlockDetails {...block} theme={theme} />;
        case "layoutContainer":
          return <TiptapBlockColumns {...block} theme={theme} />;
        case "bulletList":
        case "orderedList":
        case "taskList":
          return <TiptapBlockList {...block} theme={theme} />;
        case "codeBlock":
          return <TiptapBlockCode {...block} theme={theme} />;
        case "image":
          return <TiptapBlockImage {...block} theme={theme} />;
        case "video":
        case "audio":
        case "attachment":
        case "iframe":
          return <TiptapBlockMedia {...block} theme={theme} allowedIframeDomains={allowedIframeDomains} />;
        case "mathematics":
          return <TiptapBlockMath {...block} theme={theme} />;
        case "tableOfContents":
        case "pageBreak":
          return <TiptapBlockToc {...block} theme={theme} />;
        case "table":
          return <TiptapBlockTable {...block} theme={theme} />;
        case "horizontalRule":
          return <TiptapBlockHr {...block} theme={theme} />;
        default:
          return null;
      }
    })
  }
</div>
