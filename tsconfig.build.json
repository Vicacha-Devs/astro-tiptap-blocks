{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "declaration": true
  },
  "include": ["src/lib/**/*.ts", "src/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".storybook",
    "src/**/*.stories.ts",
    "src/**/*.test.ts"
  ]
}
